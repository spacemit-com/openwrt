From 7bb0e57ebde23c3dff303d24e6ecc2f8f12d4eba Mon Sep 17 00:00:00 2001
From: haiqianghuang <11041324+haiqianghuang@user.noreply.gitee.com>
Date: Fri, 16 Aug 2024 19:30:31 +0800
Subject: [PATCH] fix can clk freq error

Change-Id: Ib4632eebdcac38872badfca8c8126589ab936c5a
---
 drivers/net/can/flexcan/flexcan-core.c | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/drivers/net/can/flexcan/flexcan-core.c b/drivers/net/can/flexcan/flexcan-core.c
index a5d2149b14d1..0d080e4813fc 100644
--- a/drivers/net/can/flexcan/flexcan-core.c
+++ b/drivers/net/can/flexcan/flexcan-core.c
@@ -2198,6 +2198,21 @@ static int flexcan_probe(struct platform_device *pdev)
 			return PTR_ERR(clk_per);
 		}
 		clock_freq = clk_get_rate(clk_per);
+	} else {
+		clk_per = devm_clk_get(&pdev->dev, "per");
+		if (IS_ERR(clk_per)) {
+			dev_err(&pdev->dev, "no per clock defined\n");
+			return PTR_ERR(clk_per);
+		}
+		clk_set_rate(clk_per, clock_freq);
+	}
+
+	if (!clk_ipg) {
+		clk_ipg = devm_clk_get(&pdev->dev, "ipg");
+		if (IS_ERR(clk_ipg)) {
+			dev_err(&pdev->dev, "no ipg clock defined\n");
+			return PTR_ERR(clk_ipg);
+		}
 	}
 
 	reset = devm_reset_control_get_optional(&pdev->dev,NULL);
-- 
2.34.1

